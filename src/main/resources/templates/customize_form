<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Extra Customization - VibeRoute</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" th:href="@{/css/styles.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .custom-card { border-radius: 25px; border: none; box-shadow: 0 15px 35px rgba(0,0,0,0.1); overflow: hidden; }
        .card-header h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: -0.5px; }
        .form-label { font-weight: 600; color: #003366; }
        .section-title { border-bottom: 2px solid #ffcc00; display: inline-block; padding-bottom: 5px; margin-bottom: 20px; color: #003366; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px; }
        .vehicle-option { cursor: pointer; transition: all 0.2s; border: 2px solid #eee; border-radius: 10px; padding: 15px; text-align: center; display: block; }
        .vehicle-option:hover { background: #f8f9fa; border-color: #ddd; }
        .vehicle-radio:checked + .vehicle-option { border-color: #003366; background: rgba(0, 51, 102, 0.05); color: #003366; font-weight: bold; }
        .vehicle-radio { display: none; }
        .activity-box { background: #fff; border: 1px solid #eee; border-radius: 10px; padding: 10px 15px; transition: all 0.2s; cursor: pointer; display: block; margin-bottom: 10px; }
        .activity-box:hover { border-color: #003366; }
        .activity-check:checked + .activity-box { background: #003366; color: #fff; border-color: #003366; }
        .activity-check { display: none; }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" th:href="@{/}" style="font-family: 'Pacifico', cursive;">VibeRoute</a>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-9">
                <div class="card custom-card">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h3 class="mb-0">Tailor Your Experience</h3>
                    </div>
                    <div class="card-body p-4">
                        <form th:action="@{/customization/save}" th:object="${customization}" method="post" id="mainForm">
                            <input type="hidden" th:field="*{customizationId}">
                            <input type="hidden" th:field="*{bookingId}">
                            <input type="hidden" th:field="*{extraActivities}" id="hiddenActivities">

                            <h5 class="section-title">Accommodation & Dining</h5>
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Room Category</label>
                                        <select th:field="*{roomType}" class="form-control" id="roomTypeSelect">
                                            <option value="Budget">Budget (Standard)</option>
                                            <option value="Semi-Luxury">Semi-Luxury (Comfort)</option>
                                            <option value="Luxury">Luxury (Premium)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Meal Preference</label>
                                        <select th:field="*{mealPlan}" class="form-control" id="mealPlanSelect">
                                            <option value="Breakfast Only">Breakfast Only</option>
                                            <option value="Half Board">Half Board (B+D)</option>
                                            <option value="Full Board">Full Board (B+L+D)</option>
                                            <option value="All Inclusive">All Inclusive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <h5 class="section-title">Transportation Options</h5>
                            <div class="row mb-4">
                                <div class="col-md-3">
                                    <input type="radio" th:field="*{vehicleType}" value="Economy Car" id="v1" class="vehicle-radio">
                                    <label for="v1" class="vehicle-option">
                                        <div>Economy Car</div>
                                        <div class="text-muted small">Standard</div>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <input type="radio" th:field="*{vehicleType}" value="Car" id="v2" class="vehicle-radio">
                                    <label for="v2" class="vehicle-option">
                                        <div>Car</div>
                                        <div class="text-muted small">+$40/day</div>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <input type="radio" th:field="*{vehicleType}" value="SUV" id="v3" class="vehicle-radio">
                                    <label for="v3" class="vehicle-option">
                                        <div>SUV / Jeep</div>
                                        <div class="text-muted small">+$70/day</div>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <input type="radio" th:field="*{vehicleType}" value="Family Van" id="v4" class="vehicle-radio">
                                    <label for="v4" class="vehicle-option">
                                        <div>Family Van</div>
                                        <div class="text-muted small">+$100/day</div>
                                    </label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <h5 class="section-title">Special Services</h5>
                                    <div class="form-group border p-3 rounded bg-white shadow-sm">
                                        <div class="custom-control custom-switch mb-2">
                                            <input type="checkbox" class="custom-control-input" id="driverSwitch" th:field="*{needsDriver}">
                                            <label class="custom-control-label font-weight-bold" for="driverSwitch">Professional Driver (+$25/day)</label>
                                        </div>
                                        <div class="custom-control custom-switch mb-2">
                                            <input type="checkbox" class="custom-control-input" id="guideSwitch" th:field="*{needsGuide}">
                                            <label class="custom-control-label font-weight-bold" for="guideSwitch">Tour Guide (+$30/day)</label>
                                        </div>
                                        <div class="custom-control custom-switch">
                                            <input type="checkbox" class="custom-control-input" id="pickupSwitch" th:field="*{needsAirportPickup}">
                                            <label class="custom-control-label font-weight-bold" for="pickupSwitch">Airport Shuttle (+$50)</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h5 class="section-title">Fun Activities (+$50 each)</h5>
                                    <div class="row no-gutters">
                                        <div class="col-6 px-1">
                                            <input type="checkbox" class="activity-check" id="act1" value="Surfing">
                                            <label for="act1" class="activity-box small font-weight-bold text-center">Surfing</label>
                                        </div>
                                        <div class="col-6 px-1">
                                            <input type="checkbox" class="activity-check" id="act2" value="Night Safari">
                                            <label for="act2" class="activity-box small font-weight-bold text-center">Night Safari</label>
                                        </div>
                                        <div class="col-6 px-1">
                                            <input type="checkbox" class="activity-check" id="act3" value="Elephant Ride">
                                            <label for="act3" class="activity-box small font-weight-bold text-center">Elephant Ride</label>
                                        </div>
                                        <div class="col-6 px-1">
                                            <input type="checkbox" class="activity-check" id="act4" value="Whale Watching">
                                            <label for="act4" class="activity-box small font-weight-bold text-center">Whale Watching</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-dark mt-4 border-0 text-center" style="background: #003366; color: white; border-radius: 12px;">
                                <span class="font-weight-bold text-uppercase small mr-3" style="letter-spacing: 1px;">Extra Cost:</span>
                                <h3 class="d-inline-block mb-0 font-weight-bold">$<span id="costDisplay">0</span></h3>
                                <input type="hidden" th:field="*{additionalCost}" id="hiddenCost">
                            </div>

                            <div class="row mt-4">
                                <div class="col-6">
                                    <a th:href="@{/my-bookings}" class="btn btn-outline-secondary btn-block">Cancel</a>
                                </div>
                                <div class="col-6">
                                    <button type="submit" class="btn btn-warning btn-block font-weight-bold text-dark">Save & Proceed to Payment</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function updateCost() {
            let cost = 0;

            // Room
            let room = document.getElementById('roomTypeSelect').value;
            if(room === 'Luxury') cost += 150;
            else if(room === 'Semi-Luxury') cost += 75;

            // Meal
            let meal = document.getElementById('mealPlanSelect').value;
            if(meal === 'All Inclusive') cost += 100;
            else if(meal === 'Full Board') cost += 60;
            else if(meal === 'Half Board') cost += 30;

            // Vehicle
            let vehicleEl = document.querySelector('input[name="vehicleType"]:checked');
            if(vehicleEl) {
                let vehicle = vehicleEl.value;
                if(vehicle === 'Car') cost += 120;
                else if(vehicle === 'SUV') cost += 210;
                else if(vehicle === 'Family Van') cost += 300;
            }

            // Activities
            let selectedActs = [];
            document.querySelectorAll('.activity-check:checked').forEach(cb => {
                selectedActs.push(cb.value);
            });
            cost += selectedActs.length * 50;
            document.getElementById('hiddenActivities').value = selectedActs.join(', ');

            // Services
            if (document.getElementById('driverSwitch').checked) cost += 75; // 3 days est
            if (document.getElementById('guideSwitch').checked) cost += 90;
            if (document.getElementById('pickupSwitch').checked) cost += 50;

            document.getElementById('costDisplay').innerText = cost;
            document.getElementById('hiddenCost').value = cost;
        }

        function initActivities() {
            let currentActs = document.getElementById('hiddenActivities').value.split(', ');
            document.querySelectorAll('.activity-check').forEach(cb => {
                if(currentActs.includes(cb.value)) cb.checked = true;
            });
            updateCost();
        }

        document.querySelectorAll('select, input').forEach(el => {
            el.addEventListener('change', updateCost);
        });

        window.onload = initActivities;
    </script>
</body>
</html>